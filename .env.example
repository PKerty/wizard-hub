# Amplitude (browser SDK uses NEXT_PUBLIC_ prefix to be exposed to client)
NEXT_PUBLIC_AMPLITUDE_API_KEY=your-key-here
NEXT_PUBLIC_AMPLITUDE_ENABLED=true
# Session Replay is a paid feature — leave false unless you've enabled it in your plan.
NEXT_PUBLIC_AMPLITUDE_SESSION_REPLAY=false

# Wizard World API
WIZARD_WORLD_API_BASE_URL=https://wizard-world-api.com/api
